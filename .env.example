# ---------------------------------------------------------------------------
# sailbill-agent configuration.  Copy to `.env` and fill in what you have.
# Everything here is optional: the agent runs fully offline with rule-based
# extraction when no LLM key is configured (see README "3-minute demo").
# ---------------------------------------------------------------------------

# --- LLM (any OpenAI-compatible endpoint) ---------------------------------
# DeepSeek: https://api.deepseek.com/v1  model=deepseek-chat
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# Local:    http://127.0.0.1:8000/v1  model=your-model
SAILBILL_LLM_PROVIDER=deepseek
SAILBILL_LLM_MODEL=deepseek-chat
SAILBILL_LLM_BASE_URL=https://api.deepseek.com/v1
SAILBILL_LLM_API_KEY=
SAILBILL_LLM_TEMPERATURE=0
SAILBILL_LLM_TIMEOUT=90

# Force deterministic only mode (no network calls at all) when true.
SAILBILL_OFFLINE=false

# --- OCR service (PDF / images) -------------------------------------------
SAILBILL_OCR_ENDPOINT=http://36.103.199.11:5002
SAILBILL_OCR_TASK=orderChange
SAILBILL_OCR_TIMEOUT=300
SAILBILL_OCR_CACHE=true

# How a *local* file is turned into a URL the OCR service can download.
#   auto      -> try `public_base_url`, then `upload`, else fail with guidance
#   public    -> file is already reachable at SAILBILL_PUBLIC_BASE_URL + name
#   upload    -> POST the file to SAILBILL_UPLOAD_ENDPOINT, parse a URL from the
#                response (JSON top-level/data/files or plain-text URL)
#   none      -> disable OCR network calls (fixtures / offline replay only)
SAILBILL_FILE_DELIVERY=auto
SAILBILL_PUBLIC_BASE_URL=
# Example: uguu.se transient hosting (direct link, expires in 3h)
#   SAILBILL_UPLOAD_ENDPOINT=https://uguu.se/upload?output=json
#   SAILBILL_UPLOAD_FILE_FIELD=files[]
SAILBILL_UPLOAD_ENDPOINT=
# multipart field name for the file part (default "file")
SAILBILL_UPLOAD_FILE_FIELD=file
# extra form fields some services require, e.g. "reqtype=fileupload,time=1h"
SAILBILL_UPLOAD_EXTRA_FIELDS=

# --- matching / decision thresholds --------------------------------------
SAILBILL_CONFIDENCE_REVIEW=0.60
SAILBILL_AMOUNT_TOLERANCE=0.01

# The entity whose books are being kept.  Without it AR/AP cannot be decided and
# records go to PENDING_REVIEW instead of being posted (never defaulted to AP).
SAILBILL_ACCOUNTING_ENTITY=
